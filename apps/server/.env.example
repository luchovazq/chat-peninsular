# Base de datos (PostgreSQL en Docker)
DATABASE_URL="postgresql://chatpeninsula:password@localhost:5432/chatpeninsula"

# URL pública del frontend (para construir los links de magic link e invitaciones)
APP_URL="http://localhost:3000"

# Puerto del servidor
PORT=3001

# Sesión
SESSION_TTL_DAYS=30

# SMTP (opcional en desarrollo: si no se configura, los links se imprimen en la consola)
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Chat Peninsular <noreply@tudominio.com>"

# Logging
LOG_LEVEL="info"
